@model IEnumerable<ReCenterHub.Models.WorkshopBooking>

@{
    ViewData["Title"] = "My Workshops";
    var upcoming = ViewData["UpcomingCount"] as int? ?? 0;
}

<div class="page-heading">
    <span class="eyebrow">Your bookings</span>
    <h1>My Workshop Bookings</h1>
    <p>You have @upcoming upcoming workshop@(upcoming == 1 ? "" : "s").</p>
</div>

<div class="table-card">
    <div class="table-toolbar">
        <form asp-action="Index" method="get" class="filter-form" style="display: flex; gap: 16px;">
            <input type="text" name="instituitionName" value="@ViewData["instituitionName"]" 
                   class="form-control" placeholder="Institution" aria-label="Institution" />

            <input type="text" name="topic" value="@ViewData["topic"]"
                   class="form-control" placeholder="Topic" aria-label="Topic" />

            <button type="submit" class="btn-outline-brand btn-small">Search</button>
            <a asp-action="Index" class="btn-outline-brand btn-small">Clear</a>
        </form>

       
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">No workshop bookings were found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="styled-table">
                <thead>
                    <tr>
                        <th>Institution</th>
                        <th>Target audience</th>
                        <th>Topic</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Date and time</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model)
                    {
                        var status = string.IsNullOrWhiteSpace(booking.Status) ? "Pending" : booking.Status;

                        <tr>
                            <td>@booking.InstitutionName</td>
                            <td>@booking.TargetAudience</td>
                            <td>@(string.IsNullOrWhiteSpace(booking.Topic) ? "Not specified" : booking.Topic)</td>
                            <td>@booking.PhoneNumber</td>
                            <td>@booking.EmailAddress</td>
                            <td>@booking.Date_and_Time.ToString("dd MMM yyyy, HH:mm")</td>
                            <td><span class="status-chip status-@status.ToLower()">@status</span></td>
                            <td>
                                <div class="row-actions" style="display:flex; gap:16px;">
                                    @if (!BookingStatuses.isClosed(booking.Status))
                                    {
                                        <a asp-action="Update" asp-route-id="@booking.WorkshopBookingID" class="btn-outline-brand btn-small" style="width: 75px; height: 40px;">Edit</a>
                                    }

                                    <form asp-action="Delete"
                                          asp-route-id="@booking.WorkshopBookingID" method="post"
                                          onsubmit="return confirm('Are you sure you want to delete this workshop booking?');">
                                        <button type="submit" class="btn-outline-brand btn-danger-soft btn-small" style="width: 75px; height: 40px;">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>