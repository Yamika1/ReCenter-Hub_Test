<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#3f4632" />

    <title>@ViewData["Title"] - Re-Center Hub</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/bookings.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ReCenterHub.styles.css" asp-append-version="true" />
</head>

<body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="site-header">
        <div class="brand-row">
            <a class="brand"
               asp-controller="Home"
               asp-action="Index"
               aria-label="Re-Center Hub home">

                <span class="brand-mark" aria-hidden="true">R</span>

                <span>
                    <strong>RE-CENTER</strong>
                    <small>Hub for Growth · Path to Purpose</small>
                </span>
            </a>

            <div class="account-links">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="welcome-user">
                        Hello, @(User.Identity.Name ?? "there")
                    </span>

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post"
                          class="inline-form">

                        <button type="submit" class="nav-pill nav-pill-outline">
                            Sign out
                        </button>
                    </form>
                }
                else
                {
                    <a class="nav-pill nav-pill-outline"
                       asp-controller="Account"
                       asp-action="Login">
                        Sign in
                    </a>

                    <a class="nav-pill"
                       asp-controller="Account"
                       asp-action="Register">
                        Create account
                    </a>
                }
            </div>
        </div>

        <nav class="main-nav" aria-label="Main navigation">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a asp-controller="AboutMe" asp-action="Index">About Owner</a>
            <a asp-controller="AboutCompany" asp-action="Index">About Re-Center</a>
            <a asp-controller="Services" asp-action="Index">Services</a>
            <a asp-controller="FAQ" asp-action="Index">FAQs</a>
            <a asp-controller="PrivacyPolicy" asp-action="Index">Privacy Policy</a>
            <a asp-controller="Notice" asp-action="Index">Notices</a>

            @if (!User.IsInRole("Admin"))
            {
                @* Visitors and clients can book; visitors are sent to sign in first. *@
                <div class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle drop-m"
                       data-bs-toggle="dropdown"
                       href="#"
                       role="button"
                       aria-expanded="false">
                        Bookings
                    </a>

                    <ul class="dropdown-menu">
                        <li class="drop-items">
                            <a asp-controller="IndividualBooking"
                               asp-action="Create">
                                Individual Session
                            </a>
                        </li>

                        <li>
                            <hr class="dropdown-divider" />
                        </li>

                        <li class="drop-items">
                            <a asp-controller="WorkshopBooking"
                               asp-action="Create">
                                Workshop Session
                            </a>
                        </li>
                    </ul>
                </div>
            }

            @if (User.IsInRole("Client") && !User.IsInRole("Admin"))
            {
                <a asp-controller="IndividualBooking" asp-action="Index">
                    My sessions
                </a>

                <a asp-controller="WorkshopBooking" asp-action="Index">
                    My workshops
                </a>
            }

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="Admin" asp-action="Index">
                    Admin dashboard
                </a>

                <a asp-controller="Admin" asp-action="PatientHistory">
                    Patient history
                </a>
            }

            @* Authenticator security settings are available to signed-in users. *@
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Security" asp-action="SetupAuthenticator">
                    Google Authenticator
                </a>
            }
        </nav>
    </header>

    <main id="main-content" class="page-content">
        @if (TempData["Error"] is string error &&
             !string.IsNullOrWhiteSpace(error))
        {
            <div class="notice-banner notice-error" role="alert">
                @error
            </div>
        }

        @if (TempData["Notification"] is string notification &&
             !string.IsNullOrWhiteSpace(notification))
        {
            <div class="notice-banner" role="status">
                @notification
            </div>
        }

        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="footer-inner">
            <span>Re-Center Hub</span>
            <span>A Hub for Growth. A Path to Purpose.</span>

            <a asp-controller="Home" asp-action="Privacy">
                Privacy Policy
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>