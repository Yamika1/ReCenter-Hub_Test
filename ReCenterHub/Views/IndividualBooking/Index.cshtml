@model IEnumerable<ReCenterHub.Models.IndividualBooking>

@{
    ViewData["Title"] = "My Sessions";
    var upcoming = ViewData["UpcomingCount"] as int? ?? 0;
}

<div class="page-heading">
    <span class="eyebrow">Your bookings</span>
    <h1>My Individual Sessions</h1>
    <p>You have @upcoming upcoming session@(upcoming == 1 ? "" : "s").</p>
</div>

<div class="table-card">
     
    <div class="table-toolbar">
        <form asp-action="Index" method="get" style="display: flex; gap: 16px;">
            <input type="text" name="firstName" value="@ViewData["firstName"]"
                   class="form-control" placeholder="First name" aria-label="First name" />

            <input type="text" name="surname" value="@ViewData["surname"]"
                   class="form-control" placeholder="Surname" aria-label="Surname" />

            <input type="text" name="category" value="@ViewData["category"]"
                   class="form-control" placeholder="Category" aria-label="Category" />

            <button type="submit" class="btn-outline-brand btn-small">Search</button>
            <a asp-action="Index" class="btn-outline-brand btn-small">Clear</a>
        </form>

       
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">No individual bookings were found.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="styled-table">
                <thead>
                    <tr>
                        <th>First name</th>
                        <th>Surname</th>
                        <th>Category</th>
                        <th>Phone</th>
                        <th>Email</th>
                        <th>Date and time</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model)
                    {
                        var status = string.IsNullOrWhiteSpace(booking.Status) ? "Pending" : booking.Status;

                        <tr>
                            <td>@booking.FirstName</td>
                            <td>@booking.Surname</td>
                            <td>@booking.Category</td>
                            <td>@booking.PhoneNumber</td>
                            <td>@booking.EmailAddress</td>
                            <td>@booking.Date_and_Time.ToString("dd MMM yyyy, HH:mm")</td>
                            <td><span class="status-chip status-@status.ToLower()">@status</span></td>
                            <td>
                                <div class="row-actions" style="display: flex; gap: 16px;">
                                    @if (!BookingStatuses.isClosed(booking.Status))
                                    {
                                        <a asp-action="Update" asp-route-id="@booking.IndividualBookingID" class="btn-outline-brand btn-small" style="width: 75px; height: 40px;">Edit</a>
                                    }

                                    <form asp-action="Delete" asp-route-id="@booking.IndividualBookingID" method="post"  onsubmit="return confirm('Are you sure you want to delete this booking?');">
                                        <button type="submit" class="btn-outline-brand btn-danger-soft btn-small" style="width: 75px; height: 40px;">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>