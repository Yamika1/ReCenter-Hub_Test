@model ReCenterHub.Models.IndividualBooking

@{
    ViewData["Title"] = "Add Session Notes";
    var status = string.IsNullOrWhiteSpace(Model.Status) ? "Pending" : Model.Status;
}

<div class="form-card">
    <div class="form-intro">
        <h1>Add Session Notes</h1>
        <p class="text-muted">
          
            Current status: <span class="status-chip status-@status.ToLower()">@status</span>
        </p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form asp-action="AddSessionNotes" asp-route-id="@Model.IndividualBookingID" method="post">
                @Html.AntiForgeryToken()

                <input asp-for="IndividualBookingID" type="hidden" />
                <input asp-for="UserId" type="hidden"/>

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="form-grid">
                    <div class="form-field">
                        <label asp-for="FirstName" class="form-label"></label>
                        @Html.DisplayFor(model => model.FirstName)
                    </div>

                    <div class="form-field">
                        <label asp-for="Surname" class="form-label"></label>
                        @Html.DisplayFor(model => model.Surname)
                    </div>

                    <div class="form-field">
                        <label asp-for="Category" class="form-label"></label>
                        @Html.DisplayFor(model => model.Category)
                    </div>

                    <div class="form-field">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        @Html.DisplayFor(model => model.PhoneNumber)
                    </div>

                    <div class="form-field">
                        <label asp-for="EmailAddress" class="form-label"></label>
                        @Html.DisplayFor(model => model.EmailAddress)
                    </div>

                    <div class="form-field">
                        <label asp-for="Date_and_Time" class="form-label"></label>
                        @Html.DisplayFor(model => model.Date_and_Time)
                    </div>

                    <div class="form-field full-width">
                        <label asp-for="SessionNotes" class="form-label"></label>
                        <textarea asp-for="SessionNotes" class="form-control" rows="5"
                                  placeholder="Add any additional information (optional)"></textarea>
                        <span asp-validation-for="SessionNotes" class="field-validation-error"></span>
                    </div>
                </div>
               

                <div class="form-actions">
                    <button type="submit" class="btn-brand">Save changes</button>
                    <a asp-action="PatientHistory" class="btn-outline-brand">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}