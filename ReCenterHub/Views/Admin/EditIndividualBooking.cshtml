@model ReCenterHub.Models.IndividualBooking

@{
    ViewData["Title"] = "Edit Individual Booking";
    var status = string.IsNullOrWhiteSpace(Model.Status) ? "Pending" : Model.Status;
}

<div class="form-card">
    <div class="form-intro">
        <h1>Edit Individual Booking</h1>
        <p class="text-muted">
            
        </p>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-4">
    <form asp-action="EditIndividualBooking" asp-route-id="@Model.IndividualBookingID" method="post">
                @Html.AntiForgeryToken()

                <input asp-for="IndividualBookingID" type="hidden" />
                <input asp-for="UserId" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="form-grid">
    <div class="form-field">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" autocomplete="given-name" />
        <span asp-validation-for="FirstName" class="field-validation-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="Surname" class="form-label"></label>
        <input asp-for="Surname" class="form-control" autocomplete="family-name" />
        <span asp-validation-for="Surname" class="field-validation-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="Category" class="form-label"></label>
        <select asp-for="Category" class="form-select">
            <option value="">Select a category</option>
            <option value="Trauma">Trauma</option>
            <option value="Abuse">Abuse</option>
            <option value="Addiction">Addiction</option>
            <option value="Self Development">Self development</option>
            <option value="Other">Other</option>
        </select>
        <span asp-validation-for="Category" class="field-validation-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="PhoneNumber" class="form-label"></label>
        <input asp-for="PhoneNumber" class="form-control" type="tel" autocomplete="tel" />
        <span asp-validation-for="PhoneNumber" class="field-validation-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="EmailAddress" class="form-label"></label>
        <input asp-for="EmailAddress" class="form-control" type="email" autocomplete="email" />
        <span asp-validation-for="EmailAddress" class="field-validation-error"></span>
    </div>

    <div class="form-field">
        <label asp-for="Date_and_Time" class="form-label"></label>
        <input asp-for="Date_and_Time"
               class="form-control"
               type="datetime-local"
               asp-format="{0:yyyy-MM-ddTHH:mm}"
               min="@(Model.IndividualBookingID == 0 ? DateTime.Now.ToString("yyyy-MM-ddTHH:mm") : null)" />
        <span asp-validation-for="Date_and_Time" class="field-validation-error"></span>
    </div>


    <div class="form-field full-width" style="display:flex;gap:15px">
                                    <input type="hidden" name="id" value="@Model.IndividualBookingID" />
                                    <select name="status" class="form-select" aria-label="Status">
                                        @foreach (var s in BookingStatuses.All)
                                        {
                                            <option value="@s" selected="@(s == @Model.Status)">@s</option>
                                        }
                                    </select>
                                   
                                </div>


    <div class="form-field full-width">
        <label asp-for="OptionalNotes" class="form-label"></label>
        <textarea asp-for="OptionalNotes" class="form-control" rows="4"
                  placeholder="Add any additional information (optional)"></textarea>
        <span asp-validation-for="OptionalNotes" class="field-validation-error"></span>
    </div>
</div>

        <div class="form-actions">
            <button type="submit" class="btn-brand">Save changes</button>
            <a asp-action="Index" class="btn-outline-brand">Cancel</a>
        </div>
    </form>
</div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}