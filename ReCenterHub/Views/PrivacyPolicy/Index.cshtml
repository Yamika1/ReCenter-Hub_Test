@{
    ViewData["Title"] = "Privacy Notice";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">

            <div class="text-center mb-5">
                <h1 class="fw-bold">Privacy Notice</h1>
                <h4 class="mt-2">Re-Center Hub</h4>
                <p class="text-muted mb-1">Effective date: 22 October 2026</p>
                <p class="text-muted">Version 1.0</p>
            </div>

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4 p-md-5">

                    <section class="mb-4">
                        <h2 class="h4 fw-bold">1. About This Notice</h2>
                        <p>
                            This privacy notice describes how Re-Center Hub, a business,
                            collects, uses, shares, and protects your personal information.
                            It is published under section 18 of the Protection of Personal
                            Information Act, 2013 (POPIA), and follows the Information
                            Regulator's guidance for responsible parties.
                        </p>
                        <p>
                            If you have questions about anything in this notice, please
                            contact our Information Officer using the details provided
                            in Section 9.
                        </p>
                    </section>

                    <hr />

                    <section class="mb-4">
                        <h2 class="h4 fw-bold">2. Who We Are</h2>
                        <p><strong>Responsible party:</strong> Re-Center Hub</p>
                        <p><strong>Physical address:</strong> Hayfields, South Africa</p>
                        <p>
                            <strong>Website:</strong>
                            <a href="http://recenterhub-web.runasp.net/"
                               target="_blank"
                               rel="noopener noreferrer">
                                http://recenterhub-web.runasp.net/
                            </a>
                        </p>
                        <p><strong>Sector:</strong> Business</p>
                    </section>

                    <hr />

                    <section class="mb-4">
                        <h2 class="h4 fw-bold">3. What Personal Information We Collect</h2>
                        <p>
                            We collect the following categories of personal information:
                        </p>
                        <ul>
                            <li>Name and surname</li>
                            <li>Email address</li>
                            <li>Phone number</li>
                            <li>Background information provided by clients</li>
                        </ul>
                        <p>
                            We collect this information directly from you when you complete
                            a form and, where lawful, from third parties, such as
                            identity-verification providers.
                        </p>
                    </section>

                    <hr />

                    <section class="mb-4">
                        <h2 class="h4 fw-bold">4. Why We Process Your Personal Information</h2>
                        <p>
                            We process personal information for the following purpose:
                        </p>
                        <ul>
                            <li>
                                <strong>Purpose:</strong> To provide the products and
                                services you have requested.
                            </li>
                            <li>
                                <strong>Lawful basis:</strong> Performance of a contract.
                            </li>
                        </ul>
                        <p>
                            If we want to use your personal information for a new purpose
                            that is not listed here, we will inform you and, where required
                            by law, obtain your consent first.
                        </p>
                    </section>

                    <hr />

                    <section class="mb-4">
                        <h2 class="h4 fw-bold">5. How Long We Keep Your Personal Information</h2>
                        <p>
                            We keep your personal information for as long as you have a
                            relationship with us, plus a further five years where required
                            to meet applicable legal retention obligations.
                        </p>
                        <p>
                            Where a longer retention period is required by law, we will
                            retain the information for that longer period. Where you ask
                            us to delete your information and no legal retention obligation
                            applies, we will delete it where legally permitted.
                        </p>
                    </section>

                    <hr />

                    <section class="mb-4">
                        <h2 class="h4 fw-bold">6. Transfers Outside South Africa</h2>
                        <p>
                            We do not currently transfer personal information outside
                            South Africa.
                        </p>
                    </section>

                    <hr />

                    <section class="mb-4">
                        <h2 class="h4 fw-bold">7. Information Security</h2>
                        <p>
                            We take reasonable technical and organisational measures to
                            protect personal information against unauthorised or unlawful
                            processing and against accidental loss, destruction, or damage,
                            as required by Section 19 of POPIA.
                        </p>
                        <p>These measures include:</p>
                        <ul>
                            <li>Access controls</li>
                            <li>Encryption in transit</li>
                            <li>Secure backups</li>
                        </ul>
                        <p>
                            If a personal information security compromise occurs that meets
                            the requirements of Section 22 of POPIA, we will notify the
                            Information Regulator and affected data subjects as required
                            by law.
                        </p>
                    </section>

                    <hr />

                    <section class="mb-4">
                        <h2 class="h4 fw-bold">8. Your Rights Under POPIA</h2>
                        <p>
                            You have the following rights in relation to your personal
                            information, subject to applicable law:
                        </p>

                        <ul>
                            <li class="mb-2">
                                <strong>Access (Section 23):</strong>
                                You may ask us to confirm what personal information we hold
                                about you and request a copy.
                            </li>
                            <li class="mb-2">
                                <strong>Correction (Section 24):</strong>
                                You may ask us to correct information that is inaccurate,
                                irrelevant, excessive, out of date, incomplete, misleading,
                                or obtained unlawfully.
                            </li>
                            <li class="mb-2">
                                <strong>Deletion (Section 24):</strong>
                                You may request the deletion or destruction of information
                                we are no longer entitled to retain.
                            </li>
                            <li class="mb-2">
                                <strong>Objection (Section 11(3)):</strong>
                                You may object to processing on grounds permitted by POPIA,
                                including processing based on legitimate interests and
                                direct marketing, where applicable.
                            </li>
                            <li class="mb-2">
                                <strong>Withdrawal of consent (Section 11(2)(b)):</strong>
                                Where we rely on your consent, you may withdraw it.
                                Withdrawal does not affect the lawfulness of processing
                                already carried out.
                            </li>
                            <li class="mb-2">
                                <strong>Complaint (Section 74):</strong>
                                You may lodge a complaint with the Information Regulator
                                about how we handle your personal information.
                            </li>
                        </ul>

                        <p>
                            To exercise any of these rights, please contact our
                            Information Officer using the details below.
                        </p>
                    </section>

                    <hr />

                    <section class="mb-4">
                        <h2 class="h4 fw-bold">9. Information Officer</h2>
                        <p>
                            Our Information Officer is
                            <strong>Sinolizwi Ntlokwana</strong>.
                        </p>
                        <p>
                            <strong>Email:</strong>
                            <a href="mailto:info.recenterhub@gmail.com">
                                info.recenterhub@gmail.com
                            </a>
                        </p>
                        <p>
                            <strong>Phone:</strong>
                            <a href="tel:0613397981">061 339 7981</a>
                        </p>
                    </section>

                    <hr />

                    <section class="mb-4">
                        <h2 class="h4 fw-bold">10. Changes to This Notice</h2>
                        <p>
                            We may update this notice from time to time. The effective
                            date at the top reflects the date of the current version.
                            Material changes will be communicated to affected data
                            subjects through the same channels by which we collected
                            their personal information.
                        </p>
                    </section>

                    <div class="text-center mt-5">
                        <p class="text-muted small mb-0">
                            &copy; @DateTime.Now.Year Re-Center Hub.
                            All rights reserved.
                        </p>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>
