@model IEnumerable<ReCenterHub.Models.Notices>
@{
    ViewData["Title"] = "Notices";
}

@if (TempData["ErrorMessage"] != null)
{
<div class="alert alert-danger alert-dismissible">
    @TempData["ErrorMessage"]
    <button class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>

}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible">
        @TempData["SuccessMessage"]
        <button class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="page-heading">
    <span class="eyebrow">Updates from Re-Center Hub</span>
    <h1>Notices</h1>
    <p>Important information and announcements.</p>
</div>

<section class="notice-card">
    <h2>Welcome to Re-Center Hub</h2>
  
    <p>
        Please check this page regularly for important announcements
        and updates.
    </p>
    
    @if (Model?.Any() == false) 
    {
        <p class="mb-0 small text-muted">
            New notices will appear here when published.
        </p>
    }
     
    <ul>
        @foreach (var item in Model) 
        {
            
                <li style="display:flex; gap:10px; list-style-type:arabic-indic; margin-left: 20px;font-family:'Franklin Gothic Medium', 'Arial Narrow', Arial, sans-serif;font-display: swap;font-size:large;margin-block-end: 10px;flex: 0 0 auto; display: flex; gap: 0.5rem;">
                <strong style="flex:110;min-width:0">@item.NoticeMessage</strong>
                
               
                <a asp-action="Edit" style="height:33px; width:50px"  method="post" asp-route-id="@item.NoticeId"  
                class="btn btn-warning btn-sm">Edit</a>


                <form asp-action="Delete" asp-route-id="@item.NoticeId" method="post" onclick="return confirm('Are you sure you want to delete this notice?');"
                 >
                 <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                 

             </form>
                
            </li>
           
        }
     
    </ul>
    
    <a asp-action="Create" class="btn btn-success w-100 p-2">Create New Notice</a>
</section>