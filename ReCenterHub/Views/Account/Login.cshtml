@model ReCenterHub.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}



<div class="account-container">
    <div class="account-box">
        <h2 class="text-center mb-4">Login</h2>

        @if (TempData["Notification"] is string notification && !string.IsNullOrWhiteSpace(notification))
        {
            <div class="alert alert-success" role="status">@notification</div>
        }

        @if (TempData["Error"] is string error && !string.IsNullOrWhiteSpace(error))
        {
            <div class="alert alert-danger" role="alert">@error</div>
        }

        <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" type="password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AuthenticatorCode" class="form-label">
                    Google Authenticator code
                </label>

                <input asp-for="AuthenticatorCode"
                       class="form-control"
                       inputmode="numeric"
                       autocomplete="one-time-code"
                       maxlength="7"
                       placeholder="Enter code if 2FA is enabled" />

                <span asp-validation-for="AuthenticatorCode"
                      class="text-danger"></span>

                <small class="text-muted">
                    Leave this blank if you have not enabled two-factor authentication.
                </small>
            </div>

            <div class="form-check mb-3">
                <label class="form-check-label">
                    <input asp-for="RememberMe" class="form-check-input" />
                    @Html.DisplayNameFor(a => a.RememberMe)
                </label>
            </div>

            <button type="submit" class="btn btn-success w-100 p-2">Login</button>

            <p class="text-center mt-3">
                Don't have an account?
                <a asp-controller="Account" asp-action="Register" class="text-decoration-none">Register</a>
            </p>

            <div class="text-center">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none">Back</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}